{
  "name": "@exam/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file=.env src/main.ts",
    "worker": "node --env-file=.env src/worker.ts",
    "start": "node src/main.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env src/db/migrate.ts",
    "seed": "node --env-file=.env scripts/seed.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "models": "node scripts/fetch-models.ts"
  },
  "dependencies": {
    "@exam/contracts": "workspace:*",
    "@exam/integrity": "workspace:*",
    "@fastify/cookie": "^11.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "@node-rs/argon2": "^2.2.0",
    "drizzle-orm": "^0.45.0",
    "fastify": "^5.12.0",
    "fastify-type-provider-zod": "^7.0.0",
    "livekit-server-sdk": "^2.19.2",
    "onnxruntime-node": "^1.31.1",
    "postgres": "^3.4.9",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "drizzle-kit": "^0.31.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
