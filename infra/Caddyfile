{$SITE_ADDRESS::80} {
	handle /api/* {
		# Not compressed, so the live-monitoring event stream (SSE) is never held back by the encoder.
		reverse_proxy api:3000 {
			flush_interval -1
		}
	}

	# The last deployment's result (infra/install.sh writes it): ok, in progress, or failed with the log's end;
	# and the history of deployments with the changes each one brought.
	@deploy path /deploy-status.txt /deploy-history.txt
	handle @deploy {
		root * /status
		header Cache-Control "no-store"
		file_server
	}
	# The same, readable: a page that reads the file above and shows it in Almaty time.
	handle /deploy {
		root * /status-page
		rewrite * /index.html
		file_server
	}

	# Video calls (oral exams): LiveKit's signalling under the site's own HTTPS address (wss://), so a page
	# served over HTTPS may open it. Media itself goes straight to LiveKit's ports (7881 TCP, 7882 UDP).
	handle /rtc* {
		reverse_proxy livekit:7880
	}

	handle {
		encode zstd gzip
		root * /srv
		# The service worker must always be revalidated, or clients keep an old app shell.
		@sw path /sw.js /registerSW.js
		header @sw Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
